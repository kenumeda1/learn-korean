# Optional: same-origin proxy (production-style). When set, browser key is not used.
# VITE_LLM_PROXY_PATH=/api/chat

# Local dev: set ONE of these (uncomment and paste your key), then restart `npm run dev`.
# VITE_OPENAI_API_KEY=
# VITE_ANTHROPIC_API_KEY=

# VITE_OPENAI_BASE_URL=https://api.openai.com
# VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_ANTHROPIC_BASE_URL=https://api.anthropic.com
# VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
